# Copy this to .env and fill in your values

# Required by the bundled PostgreSQL service — use a long random value
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required — base URL of your OpenAI-compatible API endpoint
OPENAI_BASE_URL=

# Optional — only needed if the upstream API requires authentication
# OPENAI_API_KEY=

# Optional — client secret referenced by config/config.yaml for SSO
# OIDC_CLIENT_SECRET=

# Optional test-only login (fixed credentials: admin / admin)
# Keep disabled on exposed deployments
# LOCAL_AUTH=true
