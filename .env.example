# Copy this to .env and fill in your values

# Required — used to sign session JWTs (any random string, min 32 chars)
SECRET_KEY=change-me-to-a-random-32-char-string

# Required for SSO login — your Authelia client secret
# Not needed if you only use the local admin account
OIDC_CLIENT_SECRET=placeholder

# Optional — only needed if LiteLLM requires authentication
# LITELLM_API_KEY=

# Optional — enable a local admin account
# Omit both to disable (SSO-only mode)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin
